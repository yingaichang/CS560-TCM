DATABASE_URL="postgresql://user:password@localhost:5432/tcm_clinic"

# Clerk development keys and sign-in routes are populated by `npx clerk@latest env pull`.

NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Sandbox
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your_clerk_webhook_signing_secret"

# Gmail SMTP for Contact Form
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your_gmail@gmail.com"
SMTP_PASS="your_16_char_app_password"
SMTP_FROM="your_gmail@gmail.com"
CONTACT_RECEIVER_EMAIL="your_gmail@gmail.com"
